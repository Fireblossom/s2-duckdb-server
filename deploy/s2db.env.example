# Copy to deploy/s2db.env (git-ignored) and edit. Every deploy script sources it.

# ---- paths -----------------------------------------------------------------
S2DB_HOME=$HOME/s2-duckdb-server          # this checkout, with .venv/ inside
S2DB_RAW_DIR=/data/s2/raw                 # jsonl.gz mirror (s2db download writes here)
S2DB_DATA_DIR=/data/s2/data               # converted parquet
S2DB_CACHE_DIR=/data/s2/cache             # live DuckDB caches
S2DB_STATE_DIR=/data/s2/state             # api_key, serve.ctrl, manifests, status.log
S2DB_LOG_DIR=/data/s2/logs                # Slurm job logs

# ---- Slurm -----------------------------------------------------------------
SLURM_ACCOUNT=                            # -A, leave empty if not needed
SLURM_PARTITION=                          # -p, leave empty for the default partition
CHAIN_TIME=72:00:00                       # wall time of the long-running jobs
SERVE_CPUS=16
SERVE_MEM=256G
BUILD_CPUS=64
BUILD_MEM_PAPERS=1000G                    # full S2AG: ~1 TB papers, ~1.2 TB citations
BUILD_MEM_CITATIONS=1200G
BUILD_TIME=2-00:00:00
SWAP_TIME=00:30:00                        # verify + rename + reload; minutes in practice

# ---- server ----------------------------------------------------------------
S2DB_PORT=8300                            # binds 127.0.0.1 on the compute node
WARMUP_TOP=500                            # most-cited papers looked up after each start

# ---- optional: reverse tunnel compute node -> relay host ---------------------
# Compute nodes are usually unreachable from outside. If RELAY is set, the serve
# job keeps `ssh -R RELAY_PORT:localhost:S2DB_PORT RELAY` open; consumers then
# use deploy/tunnel/forward.sh to reach it. Leave empty to skip.
RELAY=                                    # e.g. tunnel@relay.example.org
RELAY_PORT=18300
TUNNEL_KEY=$HOME/.ssh/s2db_tunnel

# ---- automatic rebuilds ----------------------------------------------------
QUIET_MIN=180            # without a release marker: wait this long after the last new file
RETRY_AFTER_FAIL_H=24
CHECK_INTERVAL=900       # seconds between checks in watch.sbatch
